{
  // Landing site: static files in ./site, served on web.classifiedjunction.com.
  // worker.js only forwards marketplace links to classifiedjunction.com / admin. (see the comment there).
  "name": "classified-junction-landing",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/ads/*", "/my", "/my/*", "/payment/*", "/post", "/contact", "/refund-policy"]
  },
  "services": [{ "binding": "MARKET", "service": "classified-junction" }],
  "routes": [
    { "pattern": "web.classifiedjunction.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}
